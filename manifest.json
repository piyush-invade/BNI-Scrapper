{
  "manifest_version": 3,
  "name": "BNI Chapter Member Scraper",
  "version": "1.0.0",
  "description": "Manually scrape publicly displayed member info from a single BNI chapter page you have open, and export to Excel/CSV.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*/*"
  ]
}
